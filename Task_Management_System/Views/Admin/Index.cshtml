 
<h1>Hello @ViewBag.LoginUser</h1>
  
<div class="offcanvas offcanvas-end shadow" tabindex="-1" id="projectCopilotDrawer" style="width: 420px;">
    <div class="offcanvas-header bg-dark text-white py-3">
        <h5 class="offcanvas-title d-flex align-items-center gap-2"> 
            <span>⚡Project Assistant</span>
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
    </div>

    <div class="offcanvas-body d-flex flex-column p-3 bg-light"> 
        <div class="mb-3">
            <label class="form-label small fw-bold text-secondary mb-1">Select Project:</label>
            <select id="ddlCopilotProject" class="form-select form-select-sm border-primary shadow-sm">
                <option value="">Loading Projects... ⏳</option>
            </select>
        </div>
         
        <div id="copilotChatBox" class="flex-grow-1 overflow-auto border rounded p-3 mb-3 bg-white" style="max-height: 65vh;">
            <div class="p-2 mb-2 bg-light rounded border-start border-primary border-3">
                <small class="text-primary fw-bold">Copilot</small>
                <div class="small text-muted mt-1">
                    Project select karein aur tasks, blockers ya deadlines ke baare me sawaal puchiye!
                </div>
            </div>
        </div>
         
        <div class="input-group">
            <input type="text"
                   id="txtCopilotInput"
                   class="form-control"
                   placeholder="e.g. Kaunsa task paused hai?"
                   onkeypress="if(event.key === 'Enter') AskCopilot();" />
            <button class="btn btn-primary" id="btnSendCopilot" onclick="AskCopilot()">
                Send
            </button>
        </div>
    </div>
</div>

<div class="container">
    <div class="row">
        <div class="col-12 col-lg-6 border border-2">

            <canvas id="statsChart"></canvas>

            <input type="text" hidden value="@ViewBag.totalUser" id="user" />
            <input type="text" hidden value="@ViewBag.totalProject" id="project" />
            <input type="text" hidden value="@ViewBag.totalTask" id="task" />
        </div>

        <div class="col-12 col-lg-6 border border-2 mt-3 mt-lg-0 text-center p-3">
            <a href="/admin/UserData" class="btn btn-primary">View User</a>
            <a href="/admin/Project" class="btn btn-success">View Project</a>
            <a href="/admin/Task" class="btn btn-danger">View Task</a>

            <button type="button" class="btn btn-dark rounded-pill shadow position-relative" data-bs-toggle="offcanvas" data-bs-target="#projectCopilotDrawer">
                <span class="fw-semibold">⚡Ask AI</span>
                <span class="spinner-grow spinner-grow-sm text-success"></span>
            </button> 

        </div>
    </div>
</div>
 



 



