 
<h1>Hello @ViewBag.LoginUser</h1>

<div class="container">
    <div class="row">
        <div class="col-12 col-lg-6 border border-2">

            <canvas id="statsChart"></canvas>

            <input type="text" hidden value="@ViewBag.totalUser" id="user" />
            <input type="text" hidden value="@ViewBag.totalProject" id="project" />
            <input type="text" hidden value="@ViewBag.totalTask" id="task" />
        </div>

        <div class="col-12 col-lg-6 border border-2 mt-3 mt-lg-0 text-center">
            <a href="/admin/UserData" class="btn btn-primary">View User</a>
            <a href="/admin/Project" class="btn btn-success">View Project</a>
            <a href="/admin/Task" class="btn btn-danger">View Task</a>
        </div>
    </div>
</div>
 



 



