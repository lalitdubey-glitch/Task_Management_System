@model Task_Management_System.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container text-center mt-5">
    <h1 class="text-danger display-4">Oops!</h1>
    <h2 class="text-secondary mb-4">An unexpected error occurred while processing your request.</h2>

    @if (Model.ShowRequestId)
    {
        <div class="alert alert-warning d-inline-block text-start">
            <strong>Trace Request ID:</strong> <code>@Model.RequestId</code>
            <p class="small text-muted mb-0 mt-1">Please provide this ID if reporting this issue to support.</p>
        </div>
    }

    <div class="mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to Home</a>
    </div>
</div>