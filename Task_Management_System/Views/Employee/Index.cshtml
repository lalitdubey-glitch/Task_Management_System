        <div class="col-12 col-lg-6">
            <div class="card p-2 shadow bg-light" id="UserDetailsCard">
            </div>

        </div>
        <div class="col-12 col-lg-6">
            <canvas id="empCanva"></canvas>
        </div>

    </div>
</div>

<!-- Yahan Subtasks Render Honge -->
